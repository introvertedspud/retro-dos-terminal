{
  "name": "retro-dos-terminal",
  "version": "0.2.0",
  "description": "DOS-style terminal emulator for React. Because not everything needs to be Unix.",
  "homepage": "https://github.com/introvertedspud/retro-dos-terminal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/introvertedspud/retro-dos-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/introvertedspud/retro-dos-terminal/issues"
  },
  "keywords": [
    "react",
    "terminal",
    "dos",
    "command-prompt",
    "retro",
    "console",
    "cli"
  ],
  "author": "Shaun Bonk",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins/commands": {
      "types": "./dist/plugins/commands/index.d.ts",
      "import": "./dist/plugins/commands/index.js"
    },
    "./plugins/filesystem": {
      "types": "./dist/plugins/filesystem/index.d.ts",
      "import": "./dist/plugins/filesystem/index.js"
    },
    "./plugins/doskey": {
      "types": "./dist/plugins/doskey/index.d.ts",
      "import": "./dist/plugins/doskey/index.js"
    },
    "./plugins/programs": {
      "types": "./dist/plugins/programs/index.d.ts",
      "import": "./dist/plugins/programs/index.js"
    },
    "./plugins/effects": {
      "types": "./dist/plugins/effects/index.d.ts",
      "import": "./dist/plugins/effects/index.js"
    },
    "./presets/dos": {
      "types": "./dist/presets/dos.d.ts",
      "import": "./dist/presets/dos.js"
    },
    "./boot": {
      "types": "./dist/boot/index.d.ts",
      "import": "./dist/boot/index.js"
    },
    "./styles.css": "./dist/chunks/terminal.css",
    "./plugins/effects/styles.css": "./dist/plugins/effects/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "screenshots": "node scripts/screenshots.mjs",
    "check:exports": "node scripts/check-exports.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@tsdown/css": "^0.23.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
